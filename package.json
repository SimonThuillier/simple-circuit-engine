{
  "name": "simple-circuit-engine",
  "version": "0.1.0",
  "description": "A standalone, framework-agnostic boolean circuit simulation engine with 3D visualization, designed for educational purposes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite demo",
    "build": "tsc && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:visualizer": "vite build --config vite.visualizer.config.ts && cp scripts/visualizer/circuit-topology-visualizer.html output/",
    "build:editor": "vite build --config vite.circuit-editor.config.ts && cp scripts/editor/circuit-editor.html output/",
    "build:simulator": "vite build --config vite.circuit-simulator.config.ts && cp scripts/simulator/circuit-simulator.html output/",
    "build:engine": "vite build --config vite.circuit-engine.config.ts && cp scripts/engine/circuit-engine.html output/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:samples": "tsx scripts/samples/generate-sample-circuits.ts"
  },
  "keywords": [
    "circuit",
    "simulation",
    "boolean",
    "digital-electronics",
    "education",
    "3d",
    "threejs",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-graphviz": "^2.6.10",
    "@types/node": "^22.10.2",
    "@types/three": "^0.181.0",
    "@vitest/ui": "^4.0.15",
    "jsdom": "^27.0.1",
    "prettier": "3.7.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.2.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-graphviz": "^5.6.0",
    "lil-gui": "^0.21.0",
    "three": "^0.181.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=11.6.0"
  }
}
