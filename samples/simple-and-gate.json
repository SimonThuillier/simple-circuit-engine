{
  "$schema": "../docs/circuit-schema.json",
  "version": "1.0.0",
  "name": "Simple AND Gate",
  "description": "A basic two-input AND gate circuit demonstrating boolean logic",
  "components": [
    {
      "id": "power",
      "type": "power",
      "position": { "x": 0, "y": 2, "z": 0 }
    },
    {
      "id": "ground",
      "type": "ground",
      "position": { "x": 0, "y": -2, "z": 0 }
    },
    {
      "id": "input_a",
      "type": "switch",
      "position": { "x": -3, "y": 1, "z": 0 },
      "state": "off"
    },
    {
      "id": "input_b",
      "type": "switch",
      "position": { "x": -3, "y": -1, "z": 0 },
      "state": "off"
    },
    {
      "id": "and_gate",
      "type": "and",
      "position": { "x": 0, "y": 0, "z": 0 },
      "delay": 2
    },
    {
      "id": "output_led",
      "type": "led",
      "position": { "x": 3, "y": 0, "z": 0 }
    }
  ],
  "wires": [
    {
      "from": { "component": "power", "pin": "out" },
      "to": { "component": "input_a", "pin": "source" }
    },
    {
      "from": { "component": "power", "pin": "out" },
      "to": { "component": "input_b", "pin": "source" }
    },
    {
      "from": { "component": "input_a", "pin": "out" },
      "to": { "component": "and_gate", "pin": "in_a" }
    },
    {
      "from": { "component": "input_b", "pin": "out" },
      "to": { "component": "and_gate", "pin": "in_b" }
    },
    {
      "from": { "component": "and_gate", "pin": "out" },
      "to": { "component": "output_led", "pin": "in" }
    },
    {
      "from": { "component": "output_led", "pin": "out" },
      "to": { "component": "ground", "pin": "in" }
    }
  ]
}
