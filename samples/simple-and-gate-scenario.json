{
  "$schema": "../docs/scenario-schema.json",
  "version": "1.0.0",
  "name": "AND Gate Truth Table",
  "description": "Demonstrates all four input combinations for an AND gate",
  "circuitFile": "./simple-and-gate.json",
  "steps": [
    {
      "tick": 0,
      "description": "Initial state: both inputs OFF",
      "actions": [],
      "expect": {
        "output_led": { "state": "off" }
      }
    },
    {
      "tick": 5,
      "description": "Turn input A ON",
      "actions": [
        { "component": "input_a", "action": "toggle" }
      ],
      "expect": {
        "output_led": { "state": "off" }
      }
    },
    {
      "tick": 10,
      "description": "Turn input A OFF, input B ON",
      "actions": [
        { "component": "input_a", "action": "toggle" },
        { "component": "input_b", "action": "toggle" }
      ],
      "expect": {
        "output_led": { "state": "off" }
      }
    },
    {
      "tick": 15,
      "description": "Both inputs ON",
      "actions": [
        { "component": "input_a", "action": "toggle" }
      ],
      "expect": {
        "output_led": { "state": "on" }
      }
    },
    {
      "tick": 20,
      "description": "Reset: both inputs OFF",
      "actions": [
        { "component": "input_a", "action": "toggle" },
        { "component": "input_b", "action": "toggle" }
      ],
      "expect": {
        "output_led": { "state": "off" }
      }
    }
  ]
}
